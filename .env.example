# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# GCP Configuration
GCP_PROJECT_ID=fde-medquad-sandbox-dev
GCP_REGION=us-central1
MEDQUAD_GCS_BUCKET=gs://fde-medquad-grounding-corpus-dev

# Vertex AI / Search Configuration
VERTEX_AI_SEARCH_DATASTORE_ID=medquad-datastore-dev
VERTEX_AI_SEARCH_LOCATION=global
USE_MOCK_SEARCH=true

# Model Configuration
ROOT_ORCHESTRATOR_MODEL=gemini-2.5-flash
RESEARCHER_MODEL=gemini-2.5-pro
REVIEWER_MODEL=gemini-3.5-flash

# Security & Safety
ENABLE_MODEL_ARMOR=true
STRICT_SAFE_REFUSAL=true

# Observability
ENABLE_OPENTELEMETRY=true
EXPORT_TO_CLOUD_TRACE=false
BIGQUERY_TELEMETRY_TABLE=fde-medquad-sandbox-dev.telemetry.agent_metrics
