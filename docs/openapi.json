        ],
        "summary": "Get Latest Report",
        "description": "Retrieves the most recent validation report summary and markdown content.",
        "operationId": "get_latest_report_api_v1_evaluations_reports_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Latest Report Api V1 Evaluations Reports Latest Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evaluations/export": {
      "post": {
        "tags": [
          "Evaluations"
        ],
        "summary": "Export Conversations",
        "description": "Exports all stored conversations to an auditable JSONL file.",
        "operationId": "export_conversations_api_v1_evaluations_export_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Export Conversations Api V1 Evaluations Export Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestion/run": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Trigger Ingestion",
        "description": "Executes the automated MedQuAD corpus ingestion and Vertex AI grounding pipeline.",
        "operationId": "trigger_ingestion_api_v1_ingestion_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/IngestRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestion/status": {
      "get": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Get Ingestion Status",
        "description": "Returns local and cloud grounding corpus metadata.",
        "operationId": "get_ingestion_status_api_v1_ingestion_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Ingestion Status Api V1 Ingestion Status Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentThoughtStep": {
        "properties": {
          "agent_name": {
            "type": "string",
            "title": "Agent Name"
          },
          "step_type": {
            "type": "string",
            "title": "Step Type",
            "default": "reasoning"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "thought": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thought"
          },
          "observation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation"
          },
          "tool_called": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Called"
          },
          "tool_input": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Input"
          },
          "tool_output_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Output Summary"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "agent_name"
        ],
        "title": "AgentThoughtStep",
        "description": "Intermediate reasoning step emitted by the multi-agent system."
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional persistent session identifier"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message",
            "description": "Natural language clinical research query"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "Alias for message"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "Whether to stream response tokens via SSE",
            "default": false
          }
        },
        "type": "object",
        "title": "ChatRequest",
        "description": "Incoming user chat query."
      },
      "ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "safe_refusal": {
            "type": "boolean",
            "title": "Safe Refusal",
            "description": "True if query triggered Safe Refusal guardrails",
            "default": false
          },
          "is_refusal": {
            "type": "boolean",
            "title": "Is Refusal",
            "description": "Alias for safe_refusal",
            "default": false
          },
          "is_grounded": {
            "type": "boolean",
            "title": "Is Grounded",
            "description": "True if answer is backed by retrieved citations",
            "default": true
          },
          "category": {
            "$ref": "#/components/schemas/MedicalCategory",
            "default": "General Medicine"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "thought_steps": {
            "items": {
              "$ref": "#/components/schemas/AgentThoughtStep"
            },
            "type": "array",
            "title": "Thought Steps"
          },
          "reasoning_trace": {
            "items": {
              "$ref": "#/components/schemas/AgentThoughtStep"
            },
            "type": "array",
            "title": "Reasoning Trace"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "description": "End-to-end execution latency in milliseconds",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "response"
        ],
        "title": "ChatResponse",
        "description": "Standardized response from the MedQuAD Clinical Assistant."
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "integer",
            "title": "Citation Id",
            "description": "Sequential citation index, e.g. 1 for [1]"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "description": "NIH MedQuAD document identifier"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Document title or clinical question"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "Authoritative NIH URL link"
          },
          "authoritative_org": {
            "type": "string",
            "title": "Authoritative Org",
            "description": "Publishing institute (e.g. NCI, NHLBI, CDC)",
            "default": "NIH"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "description": "Grounding text snippet referenced"
          },
          "relevance_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Relevance Score",
            "description": "Confidence/similarity score",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "doc_id",
          "title",
          "source_url",
          "snippet"
        ],
        "title": "Citation",
        "description": "Reference citation linking grounded text to MedQuAD source chunk."
      },
      "FailureReason": {
        "type": "string",
        "enum": [
          "CITATION_MISSING",
          "PHANTOM_CITATION",
          "EMPTY_CITATION_SNIPPET",
          "UNGROUNDED_CLAIM",
          "SAFETY_POLICY_VIOLATION",
          "FALSE_REFUSAL",
          "CONTEXT_DRIFT",
          "PRESCRIPTIVE_LANGUAGE",
          "LOW_FAITHFULNESS",
          "LOW_RELEVANCE"
        ],
        "title": "FailureReason",
        "description": "Categorized root causes for clinical conversation failures."
      },
      "FeedbackRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Rating",
            "description": "+1 for helpful, -1 for unhelpful"
          },
          "comments": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "rating"
        ],
        "title": "FeedbackRequest",
        "description": "Clinician feedback submission."
      },
      "FeedbackResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "recorded"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recorded At"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "FeedbackResponse",
        "description": "Feedback acknowledgment response."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Service health status."
      },
      "IngestRequest": {
        "properties": {
          "raw_dir": {
            "type": "string",
            "title": "Raw Dir",
            "default": "data/medquad_raw"
          },
          "sync_vertex": {
            "type": "boolean",
            "title": "Sync Vertex",
            "description": "Whether to trigger Vertex AI Search import",
            "default": true
          }
        },
        "type": "object",
        "title": "IngestRequest"
      },
      "IngestionSummary": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "completed"
          },
          "total_raw_files_scanned": {
            "type": "integer",
            "title": "Total Raw Files Scanned",
            "default": 0
          },
          "total_qa_pairs_extracted": {
            "type": "integer",
            "title": "Total Qa Pairs Extracted",
            "default": 0
          },
          "total_chunks_generated": {
            "type": "integer",
            "title": "Total Chunks Generated",
            "default": 0
          },
          "gcs_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gcs Uri"
          },
          "datastore_id": {
            "type": "string",
            "title": "Datastore Id",
            "default": ""
          },
          "discovery_engine_op": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discovery Engine Op"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds",
            "default": 0.0
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "title": "IngestionSummary",
        "description": "Execution metrics and audit summary for the ingestion pipeline."
